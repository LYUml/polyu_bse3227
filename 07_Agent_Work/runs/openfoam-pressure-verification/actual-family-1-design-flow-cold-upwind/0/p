{
    format      ascii;
    class       volScalarField;
    location    "10";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField uniform 0;

boundaryField
{
    wall
    {
        type            zeroGradient;
    }
    outlet_0
    {
        type            zeroGradient;
    }
    inlet
    {
        type            zeroGradient;
    }
    outlet_2
    {
        type            zeroGradient;
    }
    outlet_1
    {
        type            zeroGradient;
    }
    outlet_3
    {
        type            zeroGradient;
    }
}


