        type            fixedValue;
        value           uniform 0;
    }
    air_outlet_0
    {
        type            fixedValue;
        value           uniform 0;
    }
    air_outlet_1
    {
        type            fixedValue;
        value           uniform 0;
    }
    air_outlet_2
    {
        type            fixedValue;
        value           uniform 0;
    }
    air_outlet_3
    {
        type            fixedValue;
        value           uniform 0;
    }
    air_wall
    {
        type            fixedValue;
        value           uniform 0;
    }
}


