FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (10 0 0);
    }

    outlet_a
    {
        type            flowRateOutletVelocity;
        volumetricFlowRate 8.466666666666666e-05;
        value uniform (0 0 0);
    }
    outlet_b
    {
        type            flowRateOutletVelocity;
        volumetricFlowRate 0.00016933333333333332;
        value uniform (0 0 0);
    }

    upperWall
    {
        type            noSlip;
    }

    lowerWall
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}

