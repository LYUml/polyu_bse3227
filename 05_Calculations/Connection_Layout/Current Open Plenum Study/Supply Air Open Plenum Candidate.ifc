#55779=IFCPROPERTYSINGLEVALUE('Source',$,IFCLABEL('Original adjacent nodes ROOT/J2; Explicit compound construction alternative: absorb the residual A-03 straight up to its verified elbow cap and all D-01 into a single tapered trunk; preserve D-01 clear profile internally and all external source end sections/rays. Side takeoff reaches 0.9m, outlet reach 1.0m, and 30 degree included trunk angle limit are study choices, not code/manufacturer/installed facts. Retain original failed separate-core scenario and require new pressure/coordination/product review.; classified construction {"elevation_m": {"classification": "assumed", "source": "Unaccepted coordination scenario:retain source native XY plane at reference z=0m. This is not an actual storey or installed duct elevation;site/ceiling/elevation evidence remains missing.", "value": 0}, "profile_interpretation": {"classification": "assumed", "source": "For this unaccepted geometric scenario only,interpret selected nominal schedule width/height as clear internal section dimensions. Actual nominal/internal convention and insulation/joint envelopes remain unverified.", "value": "scheduled_nominal_as_clear_internal"}, "project_uuid": "c1bba24e-8e5a-5d43-92a4-75ea4f4740e9", "wall_thickness_m": {"classification": "assumed", "source": "Unaccepted illustrative straight-wall geometry gauge0.8mm chosen for authoring evaluation only;no manufacturer,fabrication,stiffener,pressure-class or statutory compliance is asserted.", "value": 0.0008}}'),$);
